# Select the provider adapters once the client confirms them.
EMAIL_PROVIDER=placeholder
DRIVE_PROVIDER=placeholder

# Classification policy
CONFIDENCE_THRESHOLD=0.85
NEEDS_REVIEW_FOLDER_ID=replace-with-google-drive-folder-id
# JSON object of approved logical destinations and their Google Drive folder IDs.
ALLOWED_DRIVE_FOLDERS={"invoices":"replace-with-folder-id","contracts":"replace-with-folder-id"}
STATE_DB_PATH=data/state.sqlite3

# Claude classification. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
MAX_EXTRACTED_TEXT_CHARS=12000
# Inbox analysis only; recommendations are persisted but never executed.
INBOX_ANALYZER_MODEL=claude-haiku-4-5
INBOX_ANALYZER_PROMPT_VERSION=v1
INBOX_ANALYZER_VERSION=v1
MAX_INBOX_MESSAGE_CHARS=12000
# Conversation analysis only; all recommendations remain passive data.
CONVERSATION_ANALYZER_MODEL=claude-haiku-4-5
CONVERSATION_ANALYZER_VERSION=v1
CONVERSATION_ANALYZER_PROMPT_VERSION=v1
MAX_THREAD_MESSAGES=10
MAX_THREAD_CONTEXT_CHARS=24000
THREAD_CONTEXT_BUILDER_VERSION=v1
# Local approved knowledge only; no external vector service.
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_RETRIEVAL_LIMIT=5
KNOWLEDGE_RETRIEVER_VERSION=v1
KNOWLEDGE_INDEX_VERSION=v1
# OAuth desktop-client JSON downloaded from Google Cloud. Keep it outside this repo
# where possible; this path is intentionally not committed.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/google-drive-token.json

# Gmail polling: can safely use the same desktop OAuth client JSON as Drive,
# but uses a separate token because Gmail has a separate read-only scope.
GMAIL_OAUTH_CLIENT_SECRETS_FILE=secrets/google-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=secrets/google-gmail-token.json
GMAIL_SEARCH_QUERY=has:attachment
MAX_ATTACHMENT_BYTES=10485760

# Phase 8C1 draft creation is a separate, explicit OAuth boundary. It requests only
# gmail.compose and never sends email. Do not point this at the readonly token above.
GMAIL_COMPOSE_OAUTH_CLIENT_SECRETS_FILE=secrets/google-oauth-client.json
GMAIL_COMPOSE_OAUTH_TOKEN_FILE=secrets/google-gmail-compose-token.json
GMAIL_COMPOSE_ACCOUNT_EMAIL=support@example.com
MAX_GMAIL_DRAFT_BYTES=1000000

# Bounded transient-provider retry and local SQLite contention handling.
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_INITIAL_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=5
PROVIDER_RETRY_MULTIPLIER=2
PROVIDER_RETRY_JITTER_RATIO=0.1
PROVIDER_REQUEST_TIMEOUT_SECONDS=30
SQLITE_BUSY_TIMEOUT_MS=5000

# Operational observability and structured logging.
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
